<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for xiaomi/raphael (Snapdragon 855, msmnile).

  The device sets BOARD_USES_QCOM_HARDWARE := true (in
  device/xiaomi/sm8150-common/BoardConfigCommon.mk), which routes Make-side
  module resolution to hardware/qcom-caf/sm8150/*. Soong (Android.bp) has no
  equivalent guard, so any generic hardware/qcom/* trees that get synced
  would collide with the CAF/sm8150 versions of the same module names.

  This manifest does two jobs:
   1. <remove-project> the conflicting / wrong-SoC trees so they don't land
      on disk.
   2. Override LineageOS upstream sources with our private forks at
      erg-raphael-5-4 for the three trees where we maintain device-specific
      patches that would otherwise be wiped on `repo sync`.

  Cloning the private forks requires a credential. Set up ~/.netrc or
  configure git URL rewrites (git config global url.insteadOf) before
  the first sync.
-->
<manifest>

  <!-- Remote for our private forks -->
  <remote name="erg-raphael" fetch="https://github.com/" />

  <!-- Public raphael sources (device tree + vendor blobs). -->
  <remote name="ducks" fetch="https://github.com/" />

  <!-- 1. Remove projects we want gone entirely -->

  <!-- Generic audio HAL: collides with hardware/qcom-caf/sm8150/audio. -->
  <remove-project name="LineageOS/android_hardware_qcom_audio" path="hardware/qcom/audio" />

  <!-- Wrong-SoC trees. sdm845 = SD845, sm7250 = SD765 — not raphael. -->
  <remove-project name="LineageOS/android_hardware_qcom_sdm845_display" />
  <remove-project name="LineageOS/android_hardware_qcom_sdm845_gps" />
  <remove-project name="LineageOS/android_hardware_qcom_sm7250_display" />
  <remove-project name="LineageOS/android_hardware_qcom_sm7250_gps" />

  <!-- Right SoC but redundant with hardware/qcom-caf/sm8150/. -->
  <remove-project name="LineageOS/android_hardware_qcom_sm8150_display" />
  <remove-project name="LineageOS/android_hardware_qcom_sm8150_gps" />

  <!-- 2. Override upstream sources with our private forks. -->

  <!-- sm8150 display: our fork disables the duplicate modules so sm8350's
       composer-service architecture takes over. -->
  <remove-project name="LineageOS/android_hardware_qcom_display"
                  path="hardware/qcom-caf/sm8150/display" />
  <project name="erg-raphael-5-4/android_hardware_qcom_display_sm8150"
           path="hardware/qcom-caf/sm8150/display"
           remote="erg-raphael"
           revision="lineage-23.2-caf-sm8150-raphael" />

  <!-- sm8150 media: heavily patched (vidc_v4l2_compat.h, c2d2.h symlink,
       msm_vidc_vui_display_info_payload member rename, local include_dirs
       to find media/msm_*.h kernel UAPI). -->
  <remove-project name="LineageOS/android_hardware_qcom_media"
                  path="hardware/qcom-caf/sm8150/media" />
  <project name="erg-raphael-5-4/android_hardware_qcom_media_sm8150"
           path="hardware/qcom-caf/sm8150/media"
           remote="erg-raphael"
           revision="lineage-23.2-caf-sm8150-raphael" />

  <!-- sm8350 audio: our fork disables the duplicate audio HAL modules
       (sm8150 audio HAL wins on this build). -->
  <remove-project name="LineageOS/android_hardware_qcom_audio"
                  path="hardware/qcom-caf/sm8350/audio" />
  <project name="erg-raphael-5-4/android_hardware_qcom_audio_sm8350"
           path="hardware/qcom-caf/sm8350/audio"
           remote="erg-raphael"
           revision="lineage-23.2-caf-sm8350-raphael" />

  <!-- raphael kernel - our fork (Linux 5.4 + KernelSU-Next hooks +
       TFA9874 DAVI path enabled + LOCALVERSION suffix -qgki_ergdev +
       tfa_tx_hostless dailink macro fix). Not in the upstream manifest -
       lineage.dependencies normally pulls it via roomservice; we override
       directly to our fork. -->
  <project name="erg-raphael-5-4/android_kernel_xiaomi_sm8150"
           path="kernel/xiaomi/sm8150"
           remote="erg-raphael"
           revision="MI_RAPHAEL_5.4" />

  <!-- frameworks/opt/net/wifi - our fork carries the WifiTrackerLib fix
       so transition-mode WPA2/WPA3 (and OWE) APs are saved as the
       stronger AKM (SAE / OWE) by the Settings UI, instead of the AOSP
       default that downgrades to PSK/Open and breaks association on
       APs that mandate SAE. -->
  <remove-project name="platform/frameworks/opt/net/wifi" />
  <project name="erg-raphael-5-4/android_frameworks_opt_net_wifi"
           path="frameworks/opt/net/wifi"
           remote="erg-raphael"
           revision="25Q4-release-raphael" />

  <!-- Device trees + hardware/xiaomi - our private forks. Not in the
       upstream manifest; roomservice/lineage.dependencies would otherwise
       pull the public LineageOS trees and lose our patches (screen-off FOD
       config + namespace + libgf_hal pin, raphael UDFPS + namespace fixes,
       and the raphael Session.cpp NULL guard). Declared here so repo owns
       them and roomservice leaves them alone. -->
  <!-- raphael device tree. NOT taken from erg-raphael-5-4/android_device_xiaomi_raphael:
       that repo is a second fork of sm8150-common (all 715 commits prefixed
       "sm8150-common:"; AndroidProducts.mk / lineage_raphael.mk / BoardConfig.mk /
       device.mk have never existed in it), so it carries no product definition and
       would duplicate every Soong module in device/xiaomi/sm8150-common.
       DUCKS-QCM-5-4 carries the real tree on lineage-23.2, including motor/ (pop-up
       camera), tfa98xx/ and qdcm/. -->
  <project name="DUCKS-QCM-5-4/android_device_xiaomi_raphael"
           path="device/xiaomi/raphael"
           remote="ducks"
           revision="lineage-23.2" />

  <!-- Proprietary blobs. Absent from the original manifest entirely; without
       these the build has no camera/audio/DSP/fingerprint firmware and cannot
       produce a flashable image. -->
  <project name="DUCKS-QCM-5-4/proprietary_vendor_xiaomi_raphael"
           path="vendor/xiaomi/raphael"
           remote="ducks"
           revision="lineage-23.2" />

  <project name="DUCKS-QCM-5-4/proprietary_vendor_xiaomi_sm8150-common"
           path="vendor/xiaomi/sm8150-common"
           remote="ducks"
           revision="lineage-23.2" />

  <project name="erg-raphael-5-4/android_device_xiaomi_sm8150-common"
           path="device/xiaomi/sm8150-common"
           remote="erg-raphael"
           revision="lineage-23.2-raphael" />

  <project name="erg-raphael-5-4/android_hardware_xiaomi"
           path="hardware/xiaomi"
           remote="erg-raphael"
           revision="lineage-23.2-raphael" />

</manifest>

